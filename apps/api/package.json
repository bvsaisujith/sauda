{
  "name": "@sauda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "mic:test": "tsx scripts/mic-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sauda/shared": "*",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
