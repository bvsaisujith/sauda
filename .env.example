# Sauda environment template.
# Copy to .env and fill real values. Never commit .env.

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# Postgres connection string.
DATABASE_URL=postgresql://sauda:sauda@localhost:5432/sauda?schema=public

# OpenAI-compatible chat provider (OpenRouter by default).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text provider (Sarvam by default).
STT_BASE_URL=https://api.sarvam.ai
STT_API_KEY=
STT_MODEL=saarika:v2.5
STT_LANGUAGES=hi,bn,ta,te,kn,ml,mr,gu,pa,or,as,ur,ne,sa,ks,sd,kok,mai,brx,doi,mni,sat
